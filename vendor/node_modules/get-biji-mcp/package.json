{
  "name": "get-biji-mcp",
  "version": "0.1.1",
  "description": "MCP server for Get Notes API integration - AI-powered knowledge base search and retrieval",
  "main": "src/index.js",
  "bin": {
    "get-biji-mcp": "./src/index.js"
  },
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test tests/**/*.test.js",
    "lint": "eslint src/ tests/",
    "format": "prettier --write src/ tests/",
    "validate": "node scripts/validate.js",
    "start:prod": "./scripts/start.sh",
    "inspector": "npx @modelcontextprotocol/inspector",
    "inspector:sse": "npx @modelcontextprotocol/inspector --transport sse --url http://localhost:3000",
    "inspector:http": "npx @modelcontextprotocol/inspector --transport http --url http://localhost:8080",
    "test:config": "node scripts/test-config.js",
    "test:all": "node scripts/test-all.js",
    "test:inspector": "node scripts/test-inspector.js",
    "quick-test": "node scripts/quick-test.js"
  },
  "keywords": [
    "mcp",
    "notes",
    "api",
    "integration",
    "knowledge-base",
    "ai-search",
    "get-notes",
    "biji",
    "小x宝社区"
  ],
  "author": "小x宝社区 (Xiao-X-Bao Community)",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.4.0",
    "express": "^4.18.2",
    "winston": "^3.11.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "eslint": "^8.0.0",
    "prettier": "^3.0.0"
  }
}

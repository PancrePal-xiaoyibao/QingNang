  "servers": [
    {
      "id": "web_search",
      "display_name": "青囊·通用网页搜索",
      "server_name": "qingnang_web",
      "package": "open-websearch",
      "version": "2.2.0",
      "license": "Apache-2.0",
      "license_note": "上游仓库 LICENSE 文件为 Apache-2.0；package.json 的 license 字段缺失，以上游 LICENSE 文件为准",
      "upstream": "https://github.com/Aas-ee/open-webSearch",
      "channel": 1,
      "transport": "stdio",
      "command": [
        "bash",
        "mcp-servers/launch/web_search"
      ],
      "env": [
        {
          "key": "MODE",
          "value": "stdio",
          "required": false,
          "effect_when_missing": "默认 both，会额外监听 HTTP 3000 端口"
        },
        {
          "key": "SEARCH_MODE",
          "value": "request",
          "required": false,
          "effect_when_missing": "auto：可能启用 Playwright（需 Chromium）；强制 request 可完全避开浏览器依赖"
        },
        {
          "key": "USE_PROXY",
          "value_from": "host_profile",
          "required": false
        },
        {
          "key": "PROXY_URL",
          "value_from": "host_profile",
          "required": false
        }
      ],
      "proxy": {
        "supported": true,
        "env_keys": [
          "USE_PROXY",
          "PROXY_URL"
        ],
        "upstream_default": "http://127.0.0.1:7890",
        "auto_fill_from": "skills/qingnang/HOST_PROFILE.md 的网络/代理 小节",
        "two_stage_note": "上游 README 明确：安装期代理（npm --proxy，拉包用）与运行期代理（USE_PROXY/PROXY_URL，搜索用）是两件独立的事，必须分两步配"
      },
      "degrade_to": "bing_cn",
      "health": {
        "kind": "mcp_initialize",
        "timeout_s": 30
      },
      "command_note": "指向本地垫片（scripts/lib/make-launch-shims.py 生成）→ node_modules 内的真实入口。支持完全离线启动，且与 pnpm/npm 目录布局解耦。",
      "launch_shim": "mcp-servers/launch/web_search",
      "args": []
    },
